# Full-data inputs kept outside Git during development
# They are pinned in data_manifest.yaml and will be supplied by Zenodo/official URLs.
data/raw/cattle/CSO_ED_2020.csv
data/raw/land/AQA06_Unpivoted_2013_2025.csv

# Raw holding-linked agricultural soil source. It is used only to generate
# compact ED shares; holding identifiers must not be committed to the model.
data/external/soil/*.csv
data/external/soil/*.csv.xz
data/external/soil/*.xlsx

# Raw external GIS supplied locally. The project tracks manifests, checksums,
# source notes and overlay code, not large shapefile binaries.
data/external/spatial/ed/*.shp
data/external/spatial/ed/*.shx
data/external/spatial/ed/*.dbf
data/external/spatial/ed/*.prj
data/external/spatial/sis_soils/*.shp
data/external/spatial/sis_soils/*.shx
data/external/spatial/sis_soils/*.dbf
data/external/spatial/sis_soils/*.prj
data/external/spatial/sis_soils/*.sbn
data/external/spatial/sis_soils/*.sbx
data/external/spatial/sis_soils/*.lyr
data/external/spatial/sis_soils/*.zip
data/external/spatial/lpis/*.xlsx

# Temporary/archive formats not used as tracked source inputs
*.parquet
*.tmp
*.bak

# Other compact data/raw inputs are intentionally versioned during development.
